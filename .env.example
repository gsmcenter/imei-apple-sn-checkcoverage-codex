# Copy to .env for local development. Never commit .env or any credentials.
NODE_ENV=development
APP_ROLE=all
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://coverage:local-development-only@localhost:5432/coverage
# Generate using npm run password. Paste the complete scrypt:... value.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

TWOCAPTCHA_API_KEY=
CAPTCHAAI_API_KEY=
# Use a proxy endpoint enabled in YOUR ProxyMesh dashboard, not the account API URL.
PROXY_SERVER=http://YOUR_ENABLED_HOST.proxymesh.com:31280
PROXY_USERNAME=
PROXY_PASSWORD=
# Optional ProxyMesh URL overrides the three legacy variables above.
PROXY_URL=
PROXY_HOSTS=fr.proxymesh.com:31280,de.proxymesh.com:31280
# HTTP only; percent-encode special characters. Keep {session} literally.
# PROXY_EXTRA_URLS=evomi-de=http://LOGIN:PASSWORD_country-DE_session-{session}_lifetime-10@core-residential.evomi.com:1000,evomi-nl=http://LOGIN:PASSWORD_country-NL_session-{session}_lifetime-10@core-residential.evomi.com:1000
PROXY_EXTRA_URLS=
RATE_LIMIT_RETRIES=3

WORKER_CONCURRENCY=2
MIN_CHECK_INTERVAL_MS=3000
MAX_CHECKS_PER_DAY=1500
MAX_CAPTCHAS_PER_DAY=3000
MAX_PENDING_CHECKS=200
CHECK_TIMEOUT_MS=240000
CAPTCHA_TIMEOUT_MS=90000
# Set true only behind a trusted reverse proxy, with no direct public access to Node.
TRUST_PROXY=false
